# Copy to .env — a single file at the repo root, read by both the CMS and Astro.

# --- Payload (apps/cms) ---
# Provided by docker-compose.dev.yml locally (`pnpm dev:db`). In production it
# is rebuilt from the variables Lagoon injects (see
# apps/cms/src/lib/databaseUri.ts).
DATABASE_URI=postgres://payload:payload@localhost:5432/payload
PAYLOAD_SECRET=change-me-locally-and-in-production
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Administrator created by `pnpm seed` (only if one does not exist yet)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123

# --- Live preview (shared by the CMS and Astro) ---
# Origin of the Astro site: the admin builds the preview URL from it, and adds
# it to the CORS/CSRF allowlists.
PREVIEW_URL=http://localhost:4321
# Guards /preview/*: the admin appends it to the URL, Astro compares and 404s on
# a mismatch. Any long random string.
PREVIEW_SECRET=change-me-too
# API key of the `preview@example.com` user created by `pnpm seed`. Astro sends
# it server-side to read drafts; it never reaches the browser.
PREVIEW_API_KEY=00000000-0000-0000-0000-000000000000

# --- Astro (apps/web) ---
PAYLOAD_GRAPHQL_URL=http://localhost:3000/api/graphql
SITE_URL=http://localhost:4321
# Public URL of the admin panel, linked from the home page. Falls back to
# NEXT_PUBLIC_SERVER_URL above; when neither is set the link is simply omitted.
# CMS_URL=http://localhost:3000
