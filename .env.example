# Copier vers .env — un seul fichier à la racine, chargé par le CMS et par Astro.

# --- Payload (apps/cms) ---
# Fourni par packages/mongo-dev en local. En production, il est reconstruit à
# partir des variables injectées par Lagoon (voir apps/cms/src/lib/mongoUri.ts).
DATABASE_URI=mongodb://127.0.0.1:27017/docs?replicaSet=rs0&directConnection=true
PAYLOAD_SECRET=change-me-en-local-et-en-production
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Compte administrateur créé par `pnpm seed` (uniquement s'il n'existe pas déjà)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123

# --- Astro (apps/web) ---
PAYLOAD_GRAPHQL_URL=http://localhost:3000/api/graphql
SITE_URL=http://localhost:4321
