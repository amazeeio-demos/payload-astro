---
/**
 * Home page, one per locale. It exists before any content does, so its strings
 * live here rather than in Payload.
 *
 * The rest parameter is empty for the default locale (served at the root) and
 * carries the code for the others.
 */
import Site from '../../layouts/Site.astro'
import { docHrefFor } from '../../routes'
import { CMS_ADMIN_URL, DEFAULT_LOCALE, DOCS_ENTRY_SLUG, LOCALES, type Locale } from '../../site'

interface Strings {
  tagline: string
  docs: string
  cms: string
}

const UI: Record<Locale, Strings> = {
  en: {
    tagline: 'Content managed in Payload CMS, rendered statically by Astro.',
    docs: 'Read the documentation',
    cms: 'Open the CMS',
  },
  fr: {
    tagline: 'Contenu géré dans Payload CMS, rendu statiquement par Astro.',
    docs: 'Lire la documentation',
    cms: 'Ouvrir le CMS',
  },
}

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: locale === DEFAULT_LOCALE ? undefined : locale },
    props: { locale },
  }))
}

const { locale } = Astro.props as { locale: Locale }
const strings = UI[locale]
---

<Site locale={locale} title="Docs" description={strings.tagline}>
  <h1 class="doc-title">Docs</h1>
  <p class="doc-description">{strings.tagline}</p>
  <p>
    <a href={docHrefFor(DOCS_ENTRY_SLUG, locale)}>{strings.docs}</a>
    {CMS_ADMIN_URL ? <> · <a href={CMS_ADMIN_URL}>{strings.cms}</a></> : null}
  </p>
</Site>
