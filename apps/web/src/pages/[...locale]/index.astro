---
/**
 * Home page. Starlight only routes the pages coming from the `docs` collection,
 * so `/` and `/fr/` would 404 without this file. A file-based route wins over
 * the one Starlight injects.
 *
 * The rest parameter is empty for the default locale (served at the root) and
 * carries the code for the others.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'

import { CMS_ADMIN_URL, DEFAULT_LOCALE, DOCS_ENTRY_SLUG, LOCALES } from '../../site'

interface Strings {
  tagline: string
  docs: string
  cms: string
}

/** Kept here rather than in Payload: this page exists before any content does. */
const UI: Record<string, Strings> = {
  en: {
    tagline: 'Content managed in Payload CMS, rendered statically by Astro.',
    docs: 'Read the documentation',
    cms: 'Open the CMS',
  },
  fr: {
    tagline: 'Contenu géré dans Payload CMS, rendu statiquement par Astro.',
    docs: 'Lire la documentation',
    cms: 'Ouvrir le CMS',
  },
}

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: locale === DEFAULT_LOCALE ? undefined : locale },
    props: { locale },
  }))
}

const { locale } = Astro.props as { locale: string }
const strings = UI[locale] ?? UI[DEFAULT_LOCALE]!
const prefix = locale === DEFAULT_LOCALE ? '' : `/${locale}`

const actions = [
  { text: strings.docs, link: `${prefix}/${DOCS_ENTRY_SLUG}`, icon: 'open-book' as const },
  ...(CMS_ADMIN_URL
    ? [
        {
          text: strings.cms,
          link: CMS_ADMIN_URL,
          variant: 'secondary' as const,
          icon: 'link-alt' as const,
        },
      ]
    : []),
]
---

<StarlightPage
  frontmatter={{
    title: 'Docs',
    description: strings.tagline,
    template: 'splash',
    hero: { tagline: strings.tagline, actions },
  }}
/>
